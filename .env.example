# ConductGene Swarm — copy to .env and fill placeholders (never commit .env)

# Runtime mode: mock (CI/demo without services) | live (LLM + optional BGE)
CONDUCTGENE_MODE=mock

# LLM (OpenAI-compatible instruct gateway)
CONDUCTGENE_LLM_BASE_URL=http://your-llm-host:8002/v1
CONDUCTGENE_LLM_API_KEY=your-api-key-or-empty-for-local
CONDUCTGENE_LLM_MODEL=default
CONDUCTGENE_LLM_TIMEOUT=120

# Optional: BGE embedding + reranker for live retrieval
CONDUCTGENE_EMBEDDING_BASE_URL=http://your-embedding-host:9001
CONDUCTGENE_RERANKER_BASE_URL=http://your-reranker-host:9002

# API server
CONDUCTGENE_HOST=127.0.0.1
CONDUCTGENE_PORT=8090

# Evolution store (default: data/evolution/genes.jsonl)
CONDUCTGENE_GENE_STORE_PATH=data/evolution/genes.jsonl
CONDUCTGENE_AUDIT_STORE_PATH=data/audit/cases.jsonl
CONDUCTGENE_GENE_AUDIT_STORE_PATH=data/audit/gene_events.jsonl
CONDUCTGENE_SCENARIOS_DIR=data/scenarios

# Knowledge base directory
CONDUCTGENE_KB_DIR=data/synthetic/kb
