# ConductGene Swarm — copy to .env and fill placeholders (never commit .env)

# Runtime: mock (CI/demo) | live (LLM-backed agents, v0.4+)
CONDUCTGENE_MODE=mock

# LLM provider: mock | openrouter | lmstudio | instruct (v0.4+)
CONDUCTGENE_LLM_PROVIDER=mock

# Retrieval: memory (default) | qdrant | qdrant_rerank
CONDUCTGENE_RETRIEVAL_MODE=memory
CONDUCTGENE_RETRIEVAL_FALLBACK_TO_MEMORY=true

# OpenRouter (optional — v0.4+)
CONDUCTGENE_OPENROUTER_API_KEY=
CONDUCTGENE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CONDUCTGENE_OPENROUTER_MODELS=anthropic/claude-3.5-sonnet,openai/gpt-4o-mini,google/gemini-flash-1.5

# LM Studio (optional — v0.4+)
CONDUCTGENE_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
CONDUCTGENE_LMSTUDIO_MODEL=

# Legacy / instruct gateway (TailScale :8002)
CONDUCTGENE_LLM_BASE_URL=http://your-llm-host:8002/v1
CONDUCTGENE_LLM_API_KEY=
CONDUCTGENE_LLM_MODEL=default
CONDUCTGENE_LLM_TIMEOUT=120

# BGE embedding + reranker (MacBook Services-BGE — test tomorrow)
CONDUCTGENE_EMBEDDING_BASE_URL=http://127.0.0.1:9001
CONDUCTGENE_EMBEDDING_MODEL=BAAI/bge-m3
CONDUCTGENE_RERANKER_BASE_URL=http://127.0.0.1:9002
CONDUCTGENE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CONDUCTGENE_ENABLE_RERANKER=false
CONDUCTGENE_SERVICE_TIMEOUT=30

# Qdrant (optional vector store)
CONDUCTGENE_QDRANT_URL=http://127.0.0.1:6333
CONDUCTGENE_QDRANT_API_KEY=
CONDUCTGENE_QDRANT_COLLECTION=conductgene_policy_kb

# API server
CONDUCTGENE_HOST=127.0.0.1
CONDUCTGENE_PORT=8090

# Evolution store
CONDUCTGENE_GENE_STORE_PATH=data/evolution/genes.jsonl
CONDUCTGENE_AUDIT_STORE_PATH=data/audit/cases.jsonl
CONDUCTGENE_GENE_AUDIT_STORE_PATH=data/audit/gene_events.jsonl
CONDUCTGENE_SCENARIOS_DIR=data/scenarios
CONDUCTGENE_KB_DIR=data/synthetic/kb

# Streamlit API mode
CONDUCTGENE_UI_USE_API=false
CONDUCTGENE_API_BASE_URL=http://127.0.0.1:8090
